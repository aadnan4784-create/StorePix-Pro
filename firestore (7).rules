rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function inStore(sid) { return signedIn() && myProfile().ownerUid == sid; }
    function isOwner(sid) { return inStore(sid) && myProfile().role == 'Owner'; }
    function isMgr(sid)   { return inStore(sid) && myProfile().role in ['Owner', 'Manager']; }

    // --- Admin (aap): admins/{aap ka uid} document Firebase Console se banayein ---
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Subscription chalu hai? (license na ho to bhi allow, admin hamesha allow)
    function licOk(sid) {
      return isAdmin()
        || !exists(/databases/$(database)/documents/licenses/$(sid))
        || get(/databases/$(database)/documents/licenses/$(sid)).data.expiresAt > request.time.toMillis();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /app/{d} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /licenses/{sid} {
      allow read: if isAdmin() || inStore(sid);
      // Naya Owner sirf 14 din ka trial khud bana sakta hai; baad me sirf admin badal sakta hai
      allow create: if isAdmin() || (signedIn() && request.auth.uid == sid
        && request.resource.data.plan == 'trial'
        && request.resource.data.expiresAt <= request.time.toMillis() + 15 * 86400000);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- Users (profile + role) ---
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == 'Owner'
          && request.resource.data.ownerUid == uid)
        ||
        (uid != request.auth.uid
          && isOwner(request.auth.uid)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.role in ['Worker', 'Manager'])
      );

      allow update: if signedIn() && uid != request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role in ['Worker', 'Manager']
        && isOwner(request.auth.uid);

      allow delete: if signedIn() && uid != request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && isOwner(request.auth.uid);
    }

    // --- Store data ---
    match /stores/{sid} {

      match /meta/{d} {
        allow read: if inStore(sid);
        allow write: if isOwner(sid);
      }

      match /products/{p} {
        allow read: if inStore(sid);
        allow create, delete: if isMgr(sid) && licOk(sid);
        allow update: if licOk(sid) && (isMgr(sid)
          || (inStore(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])));
      }

      match /transactions/{t} {
        allow read: if inStore(sid);
        allow create: if inStore(sid) && request.resource.data.by == request.auth.uid && licOk(sid);
        allow update: if isMgr(sid) && licOk(sid)
          && resource.data.returned == false
          && request.resource.data.returned == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returned', 'color']);
        allow delete: if isOwner(sid) && licOk(sid);
      }

      match /customers/{c} {
        allow read: if inStore(sid);
        allow create, update: if inStore(sid) && licOk(sid);
        allow delete: if isOwner(sid) && licOk(sid);
      }

      match /days/{d} {
        allow read: if inStore(sid);
        allow write: if inStore(sid) && licOk(sid);
      }
    }
  }
}
